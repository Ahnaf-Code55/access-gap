# Documentation only: Node does not automatically load this file.
# Never commit real keys or copy this file into public/. Missing/empty key disables AI.
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# Executable always binds to 127.0.0.1; valid ports are 1..65535.
PORT=3000
# Bounded process-local controls. Invalid/empty values fail startup; see SECURITY.md.
ACCESS_GAP_PER_IP_LIMIT=10
ACCESS_GAP_GLOBAL_LIMIT=60
ACCESS_GAP_WINDOW_MS=60000
ACCESS_GAP_MAX_INFLIGHT=4
ACCESS_GAP_MAX_REQUESTS=100
ACCESS_GAP_MAX_OUTPUT_TOKENS=45000
# Leave this variable unset for localhost only. If set, use exact comma-separated HTTPS origins.
# Example (not enabled): ACCESS_GAP_ALLOWED_ORIGINS=https://demo.example,https://preview.example
# No wildcard, path, credentials, whitespace or trailing slash. This does not configure TLS/proxy trust.
# Output reservations omit input cost and are not a monetary cap. Require provider monetary controls.
