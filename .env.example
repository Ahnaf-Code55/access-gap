# Documentation only: Node does not automatically load this file.
# Never commit real keys or copy this into public/. Missing/empty key disables AI.
NEBIUS_API_KEY=
# Optional model identifier; availability and restricted JSON output need a separately authorized live test.
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# Localhost port only (1..65535); public hosting is not configured by this file.
PORT=3000
# Rate, request, output-token, byte and time limits are fixed in server.js (see SECURITY.md).
# Process-local output reservations are not a dollar cap; set provider monetary controls before public trials.
